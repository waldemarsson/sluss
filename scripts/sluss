#!/usr/bin/env bash

set -u

worktree_root="${SLUSS_WORKTREE_ROOT:-${HOME}/src/worktrees}"
agent="${SLUSS_AGENT:-opencode}"

usage() {
	cat <<'EOF'
sluss - lightweight sbx and Git worktree lifecycle

Usage:
  sluss start NAME [--agent AGENT] [SBX_CREATE_ARGS...]
  sluss list
  sluss attach NAME [AGENT_ARGS...]
  sluss exec NAME [COMMAND...]
  sluss stop NAME...
  sluss destroy NAME [--force]
  sluss path NAME

Commands:
  start      Create or start a task sandbox without attaching
  list       List sandboxes and this repository's worktrees
  attach     Start or attach to the sandbox's agent
  exec       Open a shell or execute a command in a sandbox
  stop       Stop sandboxes while preserving their state
  destroy    Remove a sandbox, worktree, and task branch safely
  path       Print a task's host worktree path

Run repository-specific commands from the primary checkout or one of its worktrees.
Set SLUSS_APP_NAME, SLUSS_AGENT, or SLUSS_WORKTREE_ROOT to change defaults.

Run "sluss COMMAND --help" for command-specific documentation.
EOF
}

start_usage() {
	cat <<'EOF'
Usage: sluss start NAME [--agent AGENT] [SBX_CREATE_ARGS...]

Create or start a task sandbox without attaching to its agent.

On first use, this command:
  1. Creates branch agent/NAME from the primary checkout's current HEAD.
  2. Creates $SLUSS_WORKTREE_ROOT/<repository>/NAME as a Git worktree.
  3. Creates an sbx sandbox named NAME using --agent, else $SLUSS_AGENT,
     else opencode.
  4. Mounts the worktree and the repository's shared Git metadata writable.

For OpenCode, sandbox port 4096 is published to an automatically selected
loopback host port unless SBX_CREATE_ARGS already publish port 4096.

If the worktree already exists, the command starts the sandbox if necessary.
Use "sluss attach NAME" when you want to open the agent interactively.

All arguments after NAME except --agent are passed to "sbx create" on first
creation. They are ignored on subsequent starts because sbx creation settings
are immutable, and so is --agent: an existing sandbox keeps the agent it was
created with. --agent is consumed by sluss and never reaches sbx; pass -- to
end sluss's own option scanning and forward the rest untouched.

Options:
  --agent AGENT  Agent to create the sandbox with, overriding $SLUSS_AGENT
  -h, --help     Show this help

Examples:
  sluss start budget
  sluss start budget --agent claude
  sluss start budget --agent copilot --kit ~/kits/dotnet-svelte
  sluss start budget --cpus 4 --memory 8g --publish 5173

Safety:
  If sbx creation fails, the new worktree and branch are removed. Sandboxes for
  the same repository share writable Git objects and refs; use one branch per task.
EOF
}

list_usage() {
	cat <<'EOF'
Usage: sluss list

List sbx sandboxes in the configured app-name scope. When run inside a Git
repository or one of its worktrees, also list that repository's host worktrees.

Aliases: sluss ls

Options:
  -h, --help    Show this help
EOF
}

attach_usage() {
	cat <<'EOF'
Usage: sluss attach NAME [AGENT_ARGS...]

Start the named sandbox and enable its remote interface:
  opencode  Start OpenCode Web on sandbox port 4096, then show port mappings.
  claude    Enable sbx support and start Claude Code Remote Control.
  copilot   Start Copilot CLI with GitHub remote steering enabled.

Other agents attach normally with "sbx run". The agent is read back from
"sbx ls --json", so the agent chosen at creation is used even if SLUSS_AGENT
later changes. Extra arguments are passed to the agent.

Unlike the other repository commands, this one needs no worktree context and
runs from any directory.

Alias: sluss run

Options:
  -h, --help    Show this help

Examples:
  sluss attach budget
  sluss attach budget --continue

Remote clients:
  OpenCode: open the host port shown by this command in a browser.
  Claude:   open claude.ai/code or the Claude mobile app.
  Copilot:  open the session from GitHub.com or GitHub Mobile.
EOF
}

exec_usage() {
	cat <<'EOF'
Usage: sluss exec NAME [COMMAND [ARG...]]

Start the named sandbox if stopped, then execute a command inside it. With no
COMMAND, open an interactive POSIX shell.

Options:
  -h, --help    Show this help

Examples:
  sluss exec budget
  sluss exec budget git status
  sluss exec budget npm --prefix frontend test
EOF
}

stop_usage() {
	cat <<'EOF'
Usage: sluss stop NAME...

Stop one or more sandboxes. Installed packages, containers, files, agent
history, published-port configuration, worktrees, and branches are preserved.
Resume with "sluss start NAME" or interactively with "sluss attach NAME".

Options:
  -h, --help    Show this help

Examples:
  sluss stop budget
  sluss stop budget auth
EOF
}

destroy_usage() {
	cat <<'EOF'
Usage: sluss destroy NAME [--force]

Permanently remove the named sbx sandbox, its host worktree, and agent/NAME.
Run this command inside the primary repository or one of its worktrees.

Without --force, destruction is refused when the task worktree has uncommitted
changes or agent/NAME has commits not merged into the primary checkout's current
branch. Merge or otherwise preserve the work before destroying the environment.

Options:
  --force       Delete even with uncommitted or unmerged work
  -h, --help    Show this help

Alias: sluss rm

Examples:
  sluss destroy budget
  sluss destroy abandoned-spike --force

Warning:
  --force permanently discards worktree changes and the task branch.
EOF
}

path_usage() {
	cat <<'EOF'
Usage: sluss path NAME

Print the absolute host path of a task's managed worktree. Run inside the
primary repository or one of its worktrees.

Options:
  -h, --help    Show this help

Examples:
  sluss path budget
  cd "$(sluss path budget)"
  code "$(sluss path budget)"
EOF
}

wants_help() {
	[[ $# -eq 1 && ("$1" == '--help' || "$1" == '-h') ]]
}

fail() {
	printf 'error: %s\n' "$1" >&2
	return 1
}

run_sbx() {
	if [[ -n "${SLUSS_APP_NAME:-}" ]]; then
		command sbx --app-name "$SLUSS_APP_NAME" "$@"
	else
		command sbx "$@"
	fi
}

repo_root() {
	local git_dir
	git_dir="$(command git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || return 1
	command dirname "$git_dir"
}

repo_name() {
	local repo_name
	repo_name="$(command basename "$1")"
	printf '%s\n' "${repo_name%.git}"
}

worktree_path() {
	printf '%s/%s/%s\n' "$worktree_root" "$(repo_name "$1")" "$2"
}

# sbx is the source of truth for which agent a sandbox was created with, so nothing is
# persisted host-side. Parsed with awk rather than jq, which is not preinstalled on macOS
# or most Linux distributions. Only "name" and "agent" keys are considered, in document
# order: sbx emits agent after name within each sandbox object. Record accumulation drops
# newlines, so a key split across lines still matches. sbx never emits a quote or backslash
# in these two values, so no unescaping is needed. The wanted name comes through the
# environment because awk -v processes backslash escapes in its value.
extract_agent() {
	SLUSS_WANTED_NAME="$1" command awk '
		BEGIN { want = ENVIRON["SLUSS_WANTED_NAME"] }
		{ json = json $0 }
		END {
			while (match(json, /"(name|agent)"[ \t]*:[ \t]*"[^"]*"/)) {
				pair = substr(json, RSTART, RLENGTH)
				json = substr(json, RSTART + RLENGTH)
				key = pair
				sub(/^"/, "", key)
				sub(/".*/, "", key)
				value = pair
				sub(/^[^:]*:[ \t]*"/, "", value)
				sub(/"$/, "", value)
				if (key == "name")
					seen = value
				else if (seen == want) {
					print value
					exit
				}
			}
		}
	'
}

# A failed sbx call is an error, not a missing agent: guessing there would report the wrong
# cause exactly when the source of truth is unreachable. Only a successful listing that names
# no agent falls back to $SLUSS_AGENT, and it says so.
environment_agent() {
	local listing selected_agent
	if ! listing="$(run_sbx ls --json)"; then
		fail "sbx ls failed; cannot determine the agent for $1"
		return 1
	fi
	selected_agent="$(printf '%s\n' "$listing" | extract_agent "$1")"
	if [[ -n "$selected_agent" ]]; then
		printf '%s\n' "$selected_agent"
		return
	fi
	printf 'warning: sbx reported no agent for %s; assuming %s\n' "$1" "$agent" >&2
	printf '%s\n' "$agent"
}

publishes_opencode_port() {
	local previous='' argument
	for argument in "$@"; do
		if [[ "$previous" == '--publish' || "$previous" == '-p' ]]; then
			[[ "$argument" =~ (^|:)4096(/tcp[46]?)?$ ]] && return 0
		fi
		if [[ "$argument" =~ ^--publish=(.*:)?4096(/tcp[46]?)?$ || "$argument" =~ ^-p=(.*:)?4096(/tcp[46]?)?$ ]]; then
			return 0
		fi
		previous="$argument"
	done
	return 1
}

require_name() {
	if [[ ! "$1" =~ ^[A-Za-z0-9][A-Za-z0-9.-]+$ ]]; then
		fail 'NAME must be at least two characters and contain only letters, numbers, dots, and hyphens'
		return 2
	fi
}

start_environment() {
	if wants_help "$@"; then
		start_usage
		return
	fi
	if [[ $# -lt 1 ]]; then
		start_usage
		return 2
	fi

	local name="$1"
	shift
	require_name "$name" || return

	# --agent is consumed here; everything else is forwarded to sbx create verbatim.
	local selected_agent="$agent"
	local -a create_args=()
	while [[ $# -gt 0 ]]; do
		case "$1" in
			--)
				shift
				create_args+=("$@")
				break
				;;
			--agent)
				if [[ $# -lt 2 ]]; then
					fail '--agent requires an agent name'
					return 2
				fi
				selected_agent="$2"
				shift 2
				;;
			--agent=*)
				selected_agent="${1#--agent=}"
				if [[ -z "$selected_agent" ]]; then
					fail '--agent requires an agent name'
					return 2
				fi
				shift
				;;
			*)
				create_args+=("$1")
				shift
				;;
		esac
	done

	local repo
	repo="$(repo_root)" || {
		fail 'run sluss start inside a Git repository'
		return 2
	}

	local worktree branch git_dir
	worktree="$(worktree_path "$repo" "$name")"
	branch="agent/$name"
	git_dir="$(command git -C "$repo" rev-parse --absolute-git-dir)"

	if [[ -d "$worktree" ]]; then
		run_sbx exec "$name" true
		return
	fi
	if [[ -e "$worktree" ]]; then
		fail "worktree path already exists: $worktree"
		return
	fi
	if command git -C "$repo" show-ref --verify --quiet "refs/heads/$branch"; then
		fail "branch already exists without its expected worktree: $branch"
		return
	fi

	command mkdir -p "$(command dirname "$worktree")" || return
	command git -C "$repo" worktree add -b "$branch" "$worktree" || return

	local -a publish_args=()
	if [[ "$selected_agent" == 'opencode' ]] &&
		! publishes_opencode_port ${create_args[@]+"${create_args[@]}"}; then
		publish_args=(--publish 4096)
	fi
	run_sbx create --name "$name" ${publish_args[@]+"${publish_args[@]}"} \
		${create_args[@]+"${create_args[@]}"} "$selected_agent" "$worktree" "$git_dir"
	local create_status=$?
	if [[ $create_status -ne 0 ]]; then
		printf 'sbx creation failed; removing worktree %s\n' "$worktree" >&2
		command git -C "$repo" worktree remove --force "$worktree"
		command git -C "$repo" branch -D "$branch" >/dev/null
		return "$create_status"
	fi
	printf 'Created %s on %s at %s using %s\n' "$name" "$branch" "$worktree" "$selected_agent"
}

list_environments() {
	if wants_help "$@"; then
		list_usage
		return
	fi
	if [[ $# -ne 0 ]]; then
		list_usage
		return 2
	fi
	run_sbx ls
	if repo="$(repo_root)"; then
		printf '\nGit worktrees for %s:\n' "$repo"
		command git -C "$repo" worktree list
	fi
}

attach_environment() {
	if wants_help "$@"; then
		attach_usage
		return
	fi
	if [[ $# -lt 1 ]]; then
		attach_usage
		return 2
	fi
	local name="$1"
	shift
	local selected_agent
	selected_agent="$(environment_agent "$name")" || return

	case "$selected_agent" in
		opencode)
		# A PID file makes repeated attach calls idempotent without matching the check itself.
		# shellcheck disable=SC2016 # Variables expand in the sandbox's shell.
		run_sbx exec "$name" sh -c '
			pid_file=/tmp/sluss-opencode-web.pid
			if test -f "$pid_file" && kill -0 "$(cat "$pid_file")" 2>/dev/null; then
				exit 0
			fi
			nohup opencode web --hostname 0.0.0.0 --port 4096 "$@" \
				>/tmp/sluss-opencode-web.log 2>&1 &
			echo $! > "$pid_file"
		' sh "$@" || return
		printf 'OpenCode Web port:\n'
		run_sbx ports "$name"
		;;
		claude)
		run_sbx settings set claude.remoteControl true || return
		run_sbx run --name "$name" -- --remote-control "$@"
		;;
		copilot)
		run_sbx run --name "$name" -- --remote "$@"
		;;
		*) run_sbx run --name "$name" -- "$@" ;;
	esac
}

exec_environment() {
	if wants_help "$@"; then
		exec_usage
		return
	fi
	if [[ $# -lt 1 ]]; then
		exec_usage
		return 2
	fi
	local name="$1"
	shift
	if [[ $# -eq 0 ]]; then
		run_sbx exec -it "$name" sh
	else
		run_sbx exec -it "$name" "$@"
	fi
}

stop_environment() {
	if wants_help "$@"; then
		stop_usage
		return
	fi
	if [[ $# -lt 1 ]]; then
		stop_usage
		return 2
	fi
	run_sbx stop "$@"
}

destroy_environment() {
	if wants_help "$@"; then
		destroy_usage
		return
	fi
	if [[ $# -lt 1 || $# -gt 2 ]]; then
		destroy_usage
		return 2
	fi

	local name="$1"
	local force=0
	if [[ $# -eq 2 ]]; then
		if [[ "$2" != '--force' ]]; then
			destroy_usage
			return 2
		fi
		force=1
	fi

	local repo
	repo="$(repo_root)" || {
		fail 'run sluss destroy inside the repository or one of its worktrees'
		return 2
	}

	local worktree branch primary_branch
	worktree="$(worktree_path "$repo" "$name")"
	branch="agent/$name"
	primary_branch="$(command git -C "$repo" branch --show-current)"
	if [[ ! -d "$worktree" ]]; then
		fail "worktree not found: $worktree"
		return
	fi

	if [[ $force -eq 0 ]]; then
		if [[ -n "$(command git -C "$worktree" status --porcelain)" ]]; then
			fail "$branch has uncommitted changes; commit them or use --force"
			return
		fi
		if ! command git -C "$repo" merge-base --is-ancestor "$branch" HEAD; then
			fail "$branch has commits not merged into $primary_branch; merge them or use --force"
			return
		fi
	fi

	run_sbx rm --force "$name" || return
	if [[ $force -eq 1 ]]; then
		command git -C "$repo" worktree remove --force "$worktree" || return
		command git -C "$repo" branch -D "$branch"
	else
		command git -C "$repo" worktree remove "$worktree" || return
		command git -C "$repo" branch -d "$branch"
	fi
}

print_path() {
	if wants_help "$@"; then
		path_usage
		return
	fi
	if [[ $# -ne 1 ]]; then
		path_usage
		return 2
	fi
	local repo
	repo="$(repo_root)" || {
		fail 'run sluss path inside the repository or one of its worktrees'
		return 2
	}
	worktree_path "$repo" "$1"
}

if [[ $# -eq 0 ]]; then
	usage
	exit 2
fi

command_name="$1"
shift
case "$command_name" in
	start) start_environment "$@" ;;
	list | ls) list_environments "$@" ;;
	attach | run) attach_environment "$@" ;;
	exec) exec_environment "$@" ;;
	stop) stop_environment "$@" ;;
	destroy | rm) destroy_environment "$@" ;;
	path) print_path "$@" ;;
	help)
		if [[ $# -eq 0 ]]; then
			usage
		else
			case "$1" in
				start) start_usage ;;
				list | ls) list_usage ;;
				attach | run) attach_usage ;;
				exec) exec_usage ;;
				stop) stop_usage ;;
				destroy | rm) destroy_usage ;;
				path) path_usage ;;
				*) usage >&2; exit 2 ;;
			esac
		fi
		;;
	--help | -h) usage ;;
	*)
		usage >&2
		exit 2
		;;
esac
